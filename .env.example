# ============================================================
# EXAMPLE ONLY — NOT REAL CREDENTIALS
#
# Copy to `.env` and fill in real values for local development:
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed. This file
# exists so the preToolUse security gate has something to
# demonstrate against — see docs/labs/04-governance-hooks/.
# ============================================================

# Database
DATABASE_URL=Data Source=retail.db

# API Keys — replace with your own, never commit real values
OPENAI_API_KEY=REPLACE_ME
COPILOT_API_TOKEN=REPLACE_ME

# JWT / Auth
JWT_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_STRING
SESSION_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_STRING

# Feature Flags
ENABLE_EXPERIMENTAL_PRICING=false
LOYALTY_POINTS_MULTIPLIER=1.0
